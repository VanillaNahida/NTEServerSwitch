<Window x:Class="NTEServerSwitch.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于本程序" Height="320" Width="458"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Grid.ColumnSpan="2" 
               Width="100" 
               HorizontalAlignment="Center">
            <Image.Source>
                <BitmapImage UriSource="pack://application:,,,/AppIcon.ico" />
            </Image.Source>
        </Image>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                   Text="《异环》官服B服切换器" 
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" 
                   Text="版本：1.0.0" 
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" 
                   Text="一个用来快捷切换《异环》官服B服的小工具，使用C#原生开发" 
                   FontSize="12" Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                    HorizontalAlignment="Center">
            <TextBlock FontSize="14" Margin="0,0,0,5">
                GitHub开源地址：
                <Hyperlink NavigateUri="https://github.com/YourGitHub" 
                           RequestNavigate="Hyperlink_RequestNavigate">
                    https://github.com/YourGitHub
                </Hyperlink>
            </TextBlock>
            <TextBlock FontSize="14">
                作者B站主页：
                <Hyperlink NavigateUri="https://space.bilibili.com/1347891621" 
                           RequestNavigate="Hyperlink_RequestNavigate">
                    https://space.bilibili.com/1347891621
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="7" Grid.ColumnSpan="2" 
                Content="确定" Width="80"
                HorizontalAlignment="Center"
                Click="OkButton_Click"/>
    </Grid>
</Window>
