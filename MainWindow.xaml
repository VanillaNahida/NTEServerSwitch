<Window x:Class="NTEServerSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="异环官服B服切换器" Height="300" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="ServerStatusText"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏路径:"
                   VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="GamePathTextBox"
                 FontSize="14" VerticalContentAlignment="Center"
                 IsReadOnly="True" Margin="0,0,10,0" Height="24"/>
        <Button Grid.Row="1" Grid.Column="2" Content="选择" x:Name="SelectPathButton"
                Click="SelectPathButton_Click" Width="80"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                     HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="一键切官服" x:Name="SwitchToOfficialButton"
                    Click="SwitchToOfficialButton_Click" Width="120"/>
            <Button Content="一键切B服" x:Name="SwitchToBButton"
                    Click="SwitchToBButton_Click" Width="120"/>
        </StackPanel>

        <Button Grid.Row="4" Grid.Column="2" Content="关于" x:Name="AboutButton"
                Click="AboutButton_Click" Width="80" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                   x:Name="StatusInfoText"
                   FontSize="12" Foreground="Gray"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
