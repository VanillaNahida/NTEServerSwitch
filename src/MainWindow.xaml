<Window x:Class="NTEServerSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="异环官服B服切换器" Height="450" Width="640"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="ServerStatusText"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="游戏路径：" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="GamePathTextBox" FontSize="13" Height="26"
                     VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="SelectPathButton" Content="选择" Width="76"
                    Click="SelectPathButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="#FFF7F7F7" BorderBrush="#FFDDDDDD" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="OfficialCacheText" FontSize="12" Foreground="#FF555555"
                           TextWrapping="Wrap" Text="官服缓存：尚未建立"/>
                <TextBlock x:Name="BilibiliCacheText" FontSize="12" Foreground="#FF555555"
                           TextWrapping="Wrap" Margin="0,4,0,0" Text="B服缓存：尚未建立"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button x:Name="SwitchToOfficialButton" Content="一键切官服" Width="130"
                    Click="SwitchToOfficialButton_Click"/>
            <Button x:Name="SwitchToBButton" Content="一键切B服" Width="130"
                    Click="SwitchToBButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <ProgressBar x:Name="WorkProgressBar" Height="8" Minimum="0" Maximum="100"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="WorkProgressText" FontSize="11" Foreground="Gray"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusInfoText" FontSize="12" Foreground="Gray"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="正在检测游戏目录…"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshCacheButton" Content="更新资源"
                        Click="RefreshCacheButton_Click"/>
                <Button x:Name="LogButton" Content="日志" Click="LogButton_Click"/>
                <Button x:Name="AboutButton" Content="关于" Click="AboutButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
